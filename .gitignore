# OS / tooling
.DS_Store
.gstack/
.claude/          # session-local state (scheduled-task locks, etc.)

# Data (large / external) — keep only the README
/data/*
!/data/README.md

# Conda / R environments
environment.lock.yml.bak
renv/library/
renv/local/
renv/cellar/
renv/staging/
.Rproj.user/
.Rhistory
.RData

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Tools built from source — keep only the README
/tools/*
!/tools/README.md

# Results: keep structure (.gitkeep) + tables/figures; ignore heavy genomic files
results/**/*.bcf
results/**/*.vcf
results/**/*.vcf.gz
results/**/*.bed
results/**/*.bim
# Phase-1/2 regenerable working directories. Final deploy/report artifacts live in
# results/{cube,tables,figures}/ and remain tracked.
results/qc/
results/ne/
# Phase-4 wolf per-chromosome intermediates (~180 MB, regenerable); keep only results/tables/wolf_*
results/wolf/

# Snakemake / logs
.snakemake/
*.log
logs/
