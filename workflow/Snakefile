# workflow/Snakefile
# The DAG that builds results/cube/results_cube.parquet.
# Heavy bioinformatics runs HERE; the Streamlit app only READS the cube.
#
# Phases 1-4 are complete: QC/structure/diversity -> N_e cube -> GBF indicators ->
# wolf load/ROH. Phase 5A adds lightweight synthesis outputs; the app only reads
# tracked cube/table/figure products.
# Rules invoke `python` from the activated environment: some macOS launchers place a
# Framework `python3` ahead of conda on PATH even when the environment is active.

configfile: "config/config.yaml"

include: "rules/qc.smk"
include: "rules/structure.smk"
include: "rules/diversity.smk"
include: "rules/ne.smk"
include: "rules/gbf.smk"
include: "rules/load.smk"
include: "rules/synthesis.smk"
include: "rules/polish.smk"


# ── Phase 1 outputs (tables + figures + validation) ───────────────────────────
PHASE1 = [
    "results/tables/qc_snp_counts.tsv",
    "results/tables/kinship_king.tsv",
    "results/figures/kinship_heatmap.png",
    "results/tables/pca_coords.tsv",
    "results/figures/pca.png",
    "results/tables/admixture_cv.tsv",
    "results/figures/admixture.png",
    "results/tables/diversity_perpop.tsv",
    "results/tables/individual_het.tsv",
    "results/tables/allelic_richness_modern.tsv",
    "results/tables/basicstats_modern.tsv",
    "results/figures/diversity_perpop.png",
    "results/tables/temporal_pi_summary.tsv",
    "results/tables/temporal_diversity.tsv",
    "results/tables/temporal_allelic_richness.tsv",
    "results/figures/temporal_diversity.png",
    "results/PHASE1_VALIDATION.md",
]


rule phase1:
    input: PHASE1


# ── Phase 2 outputs (the results cube + N_e context/cross-check) ───────────────
PHASE2 = [
    "results/cube/results_cube.parquet",   # the fragility cube (currentNe2 x filter x structure)
    "results/cube/results_cube.csv",        # human-readable mirror
    "results/figures/ne_cube.png",          # static fragility view
    "results/tables/gone2_trajectory.tsv",  # GONE2 recent-trajectory context
    "results/figures/gone2_trajectory.png",
    "results/tables/ne_metapop_xcheck.tsv", # currentNe2 -x metapopulation report cross-check
    "results/ne/neestimator/setA.standard.pruned.genepop",  # input for the MANUAL NeEstimator cross-check
    "results/PHASE2_VALIDATION.md",
]


rule phase2:
    input: PHASE2


# ── Phase 3 outputs (GBF Goal-A indicators + robustness; the live app reads these) ─
PHASE3 = [
    "results/tables/gbf_ne500.tsv",                   # N_e>500 indicator, per preset
    "results/tables/gbf_robustness.tsv",              # angle C — verdict stability across presets
    "results/tables/gbf_populations_maintained.tsv",  # PM (non-genomic, curated)
    "results/tables/gbf_summary.tsv",                 # headline scalars for the app
    "results/PHASE3_VALIDATION.md",
]


rule phase3:
    input: PHASE3


rule validate_phase3:
    """GBF indicator tables well-formed + reconcile with the cube (plan §6). Final Phase-3 gate."""
    input:
        cube    = "results/cube/results_cube.parquet",
        ne500   = "results/tables/gbf_ne500.tsv",
        robust  = "results/tables/gbf_robustness.tsv",
        pm      = "results/tables/gbf_populations_maintained.tsv",
        summary = "results/tables/gbf_summary.tsv",
    output:
        md  = "results/PHASE3_VALIDATION.md",
        tsv = "results/tables/validation_phase3.tsv",
    log: "results/logs/validate_phase3.log"
    shell:
        "python scripts/python/validate_phase3.py > {log} 2>&1 || (cat {log}; exit 1)"


# ── Phase 4 outputs (wolf genetic load + ROH; the app's wolf tab reads these) ──────
PHASE4 = [
    "results/tables/wolf_load.parquet",   # per-individual realized/masked load x GERP threshold {2,3,4}
    "results/tables/wolf_load.tsv",
    "results/tables/wolf_roh.parquet",    # per-individual F_ROH x ROH-length cutoff
    "results/tables/wolf_roh.tsv",
    "results/PHASE4_VALIDATION.md",
]


rule phase4:
    input: PHASE4


rule validate_phase4:
    """Wolf load reconciles with the deposit anchor + ROH well-formed (plan §7). Final Phase-4 gate."""
    input:
        load   = "results/tables/wolf_load.tsv",
        roh    = "results/tables/wolf_roh.tsv",
        anchor = config["paths"]["wolf"]["load_anchor"],
    output:
        md  = "results/PHASE4_VALIDATION.md",
        tsv = "results/tables/validation_phase4.tsv",
    log: "results/logs/validate_phase4.log"
    shell:
        "python scripts/python/validate_phase4.py > {log} 2>&1 || (cat {log}; exit 1)"


rule validate_phase2:
    """Cube well-formed + N_e verdicts sane (plan §5). Final Phase-2 gate."""
    input:
        cube  = "results/cube/results_cube.parquet",
        gone2 = "results/tables/gone2_trajectory.tsv",
        xchk  = "results/tables/ne_metapop_xcheck.tsv",
    output:
        md  = "results/PHASE2_VALIDATION.md",
        tsv = "results/tables/validation_phase2.tsv",
    log: "results/logs/validate_phase2.log"
    shell:
        "python scripts/python/validate_phase2.py > {log} 2>&1 || (cat {log}; exit 1)"


rule validate:
    """Reproduce-check vs the deposit/paper anchors (plan §4). Final Phase-1 gate."""
    input:
        counts = "results/tables/qc_snp_counts.tsv",
        admix  = "results/tables/admixture_cv.tsv",
        pca    = "results/tables/pca_coords.tsv",
        div    = "results/tables/diversity_perpop.tsv",
        ar     = "results/tables/allelic_richness_modern.tsv",
        tpi    = "results/tables/temporal_pi_summary.tsv",
        tdiv   = "results/tables/temporal_diversity.tsv",
        tar    = "results/tables/temporal_allelic_richness.tsv",
    output:
        md  = "results/PHASE1_VALIDATION.md",
        tsv = "results/tables/validation_report.tsv",
    log: "results/logs/validate.log"
    shell:
        "python scripts/python/validate.py > {log} 2>&1 || (cat {log}; exit 1)"


# ── Phase 5A.1 outputs (summary-table synthesis; no heavy bioinformatics) ───────
PHASE5A1 = [
    "results/tables/fragility_scorecard.tsv",
    "results/figures/fragility_scorecard.png",
    "results/tables/validation_fragility_scorecard.tsv",
    "results/PHASE5A1_VALIDATION.md",
]


rule phase5a1:
    input: PHASE5A1


# ── Full Phase 5A outputs (admissions package + reproducibility gate) ──────────
PHASE5A = PHASE5A1 + WEBSITE_ASSETS + [
    "RESEARCH_JOURNEY.md",
    "INTERVIEW_NOTES.md",
    "admissions/demo_script.md",
    "admissions/graphical_abstract.svg",
    "admissions/research_brief.md",
    "admissions/research_brief.html",
    "admissions/screenshots/01-ne-gbf-verdict.jpg",
    "admissions/screenshots/02-structure-diversity.jpg",
    "admissions/screenshots/03-wolf-load-roh.jpg",
    "admissions/screenshots/04-about-limitations.jpg",
    "report/report.html",
    "results/APP_SMOKE.md",
    "results/logs/app_smoke.log",
    "results/PHASE5A_REPRODUCIBILITY.md",
    "results/WEBSITE_VALIDATION.md",
    "dist/conservation-genomics-portfolio.zip",
    "results/WEBSITE_BUNDLE_VALIDATION.md",
    "results/tables/validation_phase5a.tsv",
    "results/PHASE5A_VALIDATION.md",
]


rule phase5a:
    input: PHASE5A


rule all:
    default_target: True
    input:
        # Phases 1-4 plus the complete Phase-5A admissions/reproducibility gate.
        # (The live Streamlit app is launched separately, not a DAG target.)
        PHASE1,
        PHASE2,
        PHASE3,
        PHASE4,
        PHASE5A,
